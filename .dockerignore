# 隐私保护：禁止将敏感数据打入镜像
data/
.env
state.json
.agent/
.tmp/
.impeccable/
logs/
# 覆盖嵌套目录，避免将工具或子模块中的本地凭据带入构建上下文。
**/.env
**/state.json
**/data/
**/.agent/
**/.tmp/
**/.impeccable/
**/logs/
*.log
*.log.*
*.tmp
*.pid
*.png
*.jpg
*.jpeg
frontend/node_modules/
frontend/dist/
.venv/

# Python 缓存
__pycache__/
*.py[cod]

# 版本控制
.git/
.gitignore

# 编辑器与系统文件
.DS_Store
Thumbs.db
.idea/
.vscode/
