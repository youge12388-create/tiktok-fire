# ============================================================
# 抖音私信自动化助手 V1 · 环境配置示例
# 复制为 .env 并填写真实值，切勿提交 .env 到 Git
# ============================================================

# Web 服务监听
PORT=8000
HOST=127.0.0.1

# 管理员登录（单管理员模式）。禁止使用默认弱口令。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 会话签名密钥：≥32 位随机串，用于 HttpOnly Cookie 签名
SESSION_SECRET=

# Cookie 是否仅 HTTPS 发送（生产走 Nginx HTTPS 时设为 true）
COOKIE_SECURE=false

# 会话有效期（秒），默认 7 天
SESSION_MAX_AGE=604800

# 可选：登录巡检间隔（分钟），默认 60。巡检每轮会真实打开一次抖音页面，
# 账号多或想降低风控压力时可调大；最小值 1。
LOGIN_CHECK_INTERVAL_MINUTES=60

# 可选：账号登录态失效时发送钉钉告警。两项需同时配置。
# 也可以在后台「系统信息 → 账号掉线通知」里直接填写；后台保存的值优先于这里。
# Webhook 地址由钉钉机器人设置页复制，包含 access_token；不要提交真实值。
DINGTALK_WEBHOOK_URL=
# 机器人“加签”安全设置中的密钥（通常以 SEC 开头）。
DINGTALK_SECRET=

# 可选：应用挂载在既有 HTTPS 站点的子路径时使用（根路径部署可留空）。
# 例如 /douyin-fire；Docker 构建前端及会话 Cookie 都会使用它。
PUBLIC_BASE_PATH=
# 子路径部署建议用独立 Cookie 名，避免与同域其他站点冲突。
SESSION_COOKIE_NAME=session
# 默认随 PUBLIC_BASE_PATH 自动推导；通常无需填写。
# SESSION_COOKIE_PATH=/douyin-fire/

# 时区
TZ=Asia/Shanghai
