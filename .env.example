# ============================================================
# 抖音私信自动化助手 V1 · 环境配置示例
# 复制为 .env 并填写真实值，切勿提交 .env 到 Git
# ============================================================

# Web 服务监听
PORT=8000
HOST=127.0.0.1

# 管理员登录（单管理员模式）。禁止使用默认弱口令。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 会话签名密钥：≥32 位随机串，用于 HttpOnly Cookie 签名
SESSION_SECRET=

# Cookie 是否仅 HTTPS 发送（生产走 Nginx HTTPS 时设为 true）
COOKIE_SECURE=false

# 会话有效期（秒），默认 7 天
SESSION_MAX_AGE=604800

# 可选：应用挂载在既有 HTTPS 站点的子路径时使用（根路径部署可留空）。
# 例如 /douyin-fire；Docker 构建前端及会话 Cookie 都会使用它。
PUBLIC_BASE_PATH=
# 子路径部署建议用独立 Cookie 名，避免与同域其他站点冲突。
SESSION_COOKIE_NAME=session
# 默认随 PUBLIC_BASE_PATH 自动推导；通常无需填写。
# SESSION_COOKIE_PATH=/douyin-fire/

# 时区
TZ=Asia/Shanghai
