# ==============================================================================
# Git 忽略规则 · 隐私保护与零泄漏规范
# ==============================================================================

# Python 缓存与编译产物
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
venv/
.venv/
env/
ENV/

# 敏感登录凭证与台账数据 (绝对禁止上传！)
state.json
data/*.json
!data/.gitkeep
data/*.pid
data/*.log
data/logs/
data/accounts/
data/archived/
data/avatars/
data/artifacts/
data/app.db
data/app.db-*
.env
frontend/node_modules/
frontend/dist/
frontend/.env.local
pytest_cache/
.pytest_cache/
tests/_tmp_data/

# 临时日志与异常截图
logs/
*.log
*.png
*.jpg
*.jpeg
# README 演示截图是公开文档资产，不属于运行时异常截图。
!docs/
!docs/images/
!docs/images/*.png

# 编辑器与系统文件
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.agent/
.cursor/
.gemini/

# 本地开发/生成产物（不提交）
.impeccable/
.tmp/
frontend/dist-deploy.zip
